# Keep the build context to what `next build` actually needs.
# Anything left in here is uploaded to the daemon on every build and, worse,
# can be copied into an image layer by accident.

.git
.github
node_modules
.next
out
build
coverage

# Secrets. `.env.example` is the only env file that may enter the context, and
# even that is unused by the build — NEXT_PUBLIC_API_URL arrives as a build arg.
.env
.env.*
!.env.example

*.pem
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.DS_Store
.vscode
.idea

# Agent/tooling material with no bearing on the built portal.
.agents
.claude
.lavish
Dockerfile
.dockerignore
deploy
docs
